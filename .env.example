# ---- Alpaca (paper trading) ----
# Get these from https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY=your_alpaca_paper_api_key
ALPACA_SECRET_KEY=your_alpaca_paper_secret_key
ALPACA_PAPER=true

# ---- Alpaca CLI (github.com/alpacahq/cli) ----
# "cli" (default) routes order execution and account/position status through
# Alpaca's official CLI binary -- satisfies the hackathon's CLI requirement.
# "sdk" falls back to the direct alpaca-py SDK call instead.
EXECUTION_BACKEND=cli
# Optional: explicit path to the alpaca(.exe) binary. If unset, resolution
# order is: PATH -> ./bin/alpaca(.exe). Install with:
# python scripts/install_alpaca_cli.py
# ALPACA_CLI_PATH=

# ---- Groq (genuinely free tier, no credit card required) ----
# Get this from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

# ---- Deployment (optional) ----
# Public URL of the live deployed dashboard (Streamlit Community Cloud) --
# shown as a clickable link on the Docs page once set. Leave unset for local dev.
# DASHBOARD_URL=https://your-app.streamlit.app/

# ---- Agent configuration ----
# Comma separated list of tickers the agent is allowed to trade
WATCHLIST=AAPL,MSFT,TSLA,NVDA,SPY
# % of account equity the agent may risk on a single position (e.g. 0.05 = 5%)
MAX_POSITION_PCT=0.05
# Max number of open positions at once
MAX_OPEN_POSITIONS=5
# Daily max drawdown before the agent stops trading for the day (e.g. 0.03 = 3%)
MAX_DAILY_LOSS_PCT=0.03

# ---- Deterministic exit engine (rule-based, no LLM call -- src/exit_engine.py) ----
# Close a stock position once it's down this % from entry (e.g. 0.08 = -8%)
STOP_LOSS_PCT=0.08
# Close a stock position once it's up this % from entry (e.g. 0.15 = +15%)
TAKE_PROFIT_PCT=0.15
# Close a short option (covered call / cash-secured put) once this fraction of
# the original credit received has been captured as profit (e.g. 0.50 = 50%,
# a standard "50% rule" for short premium)
OPTIONS_PROFIT_TARGET_PCT=0.50
# Close a short option if the cost to buy it back grows to this multiple of
# the credit originally received (e.g. 2.0 = stop once it costs 2x the credit)
OPTIONS_STOP_MULTIPLE=2.0

# ---- Options trading (defined-risk strategies only: covered call, cash-secured put) ----
# Comma separated list of tickers the agent is allowed to trade options on
OPTIONS_WATCHLIST=AAPL,MSFT,TSLA,NVDA,SPY
# Max % of account equity that may be tied up as cash collateral for cash-secured puts at once
MAX_OPTIONS_COLLATERAL_PCT=0.25
# Max number of concurrent open option positions
MAX_OPEN_OPTION_POSITIONS=3
